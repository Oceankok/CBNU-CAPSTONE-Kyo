# local
.github/copilot-instructions.md

# Python virtual environment
venv/
.venv/

# Environment variable files (never commit secrets)
.env
.env.*
!.env.example

# IDE settings
.idea/
.vscode/

# Python cache
*.pyc
__pycache__/

# SQLite database files
backend/db/*.db

# Node.js
node_modules/
frontend/dist/

# Data folders
# 원천 데이터, 전처리 데이터, 병합 데이터는 GitHub에 업로드하지 않음
data/raw/
data/processed/
data/merged/

# Large archives
*.zip
*.7z
*.tar
*.gz

# Model weights
*.pt
*.onnx
*.pth

# YOLO output results
runs/

# Test files
test_images/
test_videos/
test_vedios/
detect_log.txt

# Event logs / thumbnails
events/
backend/media/

# Generated candidate event media files
storage/candidate_events/thumbnails/*
!storage/candidate_events/thumbnails/.gitkeep

storage/candidate_events/clips/*
!storage/candidate_events/clips/.gitkeep