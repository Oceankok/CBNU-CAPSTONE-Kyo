# Save outside the checkout as <deployment root>/server.env; never commit secrets.
PPE_JWT_SECRET=
PPE_POSTGRES_PASSWORD=
# Password reserved characters must be URL-encoded.
PPE_DATABASE_URL=postgresql://kyo:CHANGE_ME@postgres:5432/kyo
PPE_API_PORT=8000
PPE_WEB_PORT=8080
# Binding is selected by Release.ps1: default localhost; -Lan opens web only.
# Keep PPE_COOKIE_SECURE=false for LAN HTTP. Do not forward the HTTP port publicly.
PPE_PROCESSING_MODE=disabled
# For HTTPS set true and supply a real public domain below.
PPE_COOKIE_SECURE=false
PPE_PUBLIC_HOST=
# Same-origin web deployment needs no CORS allowlist.
PPE_CORS_ORIGINS=
# Use codex_chatgpt through the native host, or explicitly opt into openai.
PPE_EQUIPMENT_PROVIDER=
PPE_EDUCATION_PROVIDER=
PPE_EDUCATION_MODEL=
PPE_EDUCATION_OPENAI_API_KEY=
