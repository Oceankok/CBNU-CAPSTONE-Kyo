# Native processing worker environment. Do not load this file into Docker.
# Set these variables in the same process that starts backend.processing.worker.
# No automatic startup or paid fallback is enabled by these examples.
PPE_HOST_AI_ENABLED=true
PPE_EQUIPMENT_PROVIDER=codex_chatgpt
PPE_EQUIPMENT_MODEL=
PPE_EDUCATION_PROVIDER=codex_chatgpt
PPE_EDUCATION_MODEL=
PPE_CODEX_EXECUTABLE=codex
# Only needed if the corresponding provider is explicitly switched to openai.
PPE_EQUIPMENT_OPENAI_API_KEY=
PPE_EDUCATION_OPENAI_API_KEY=
