# Copy to .env; never commit actual secrets.
# Generate a 32+ byte random secret; this blank value deliberately prevents startup.
PPE_JWT_SECRET=
PPE_API_PORT=8000
PPE_IMAGE_TAG=local
# Local HTTP only. Enable secure cookies once HTTPS is configured.
PPE_COOKIE_SECURE=false
PPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL override only. URL-encode reserved characters in URL passwords.
PPE_POSTGRES_PASSWORD=
PPE_DATABASE_URL=
PPE_DB_SEED=false
# Set remote only after configuring a native GPU worker.
PPE_PROCESSING_MODE=disabled
# Web (nginx) container: localhost only by default.
# Use 0.0.0.0 to open it to other devices on the same network (phone on the same Wi-Fi).
PPE_WEB_BIND=127.0.0.1
PPE_WEB_PORT=8080
# Subscription through the native host: provider=codex_chatgpt. Paid API: provider=openai.
# Keep disabled until a host worker is explicitly configured.
PPE_EQUIPMENT_PROVIDER=
PPE_EDUCATION_PROVIDER=
PPE_EDUCATION_MODEL=
PPE_EDUCATION_OPENAI_API_KEY=
